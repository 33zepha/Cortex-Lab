{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/proxy?path=:path*" },
    { "source": "/missions", "destination": "/index.html" },
    { "source": "/missions/(.*)", "destination": "/index.html" },
    { "source": "/system", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" }
  ]
}
