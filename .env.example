# VPS Hostinger (KVM2) — connexion SSH
VPS_HOST=
VPS_PORT=22
VPS_USER=root
# Une seule des deux méthodes ci-dessous :
VPS_PASSWORD=
VPS_SSH_KEY_PATH=

# Cortex API runtime (VPS)
# Secret partagé entre l'API Cortex centrale et le proxy Vercel.
CORTEX_API_TOKEN=
# Bind local-only par défaut : Cloudflare Tunnel rejoint 127.0.0.1 sans exposer le port 4000.
API_HOST=127.0.0.1
API_PORT=4000
OPENAI_API_KEY=
# Optionnel : liste CSV d'origines navigateur autorisées. En production via proxy Vercel, laisser vide.
CORTEX_ALLOWED_ORIGINS=

# Vercel server-side proxy
# URL HTTPS publique de l'API Cortex centrale, idéalement https://api.cortexlab.online via Cloudflare Tunnel.
CORTEX_API_ORIGIN=

# Frontend local uniquement. En preview/production, laisser vide pour utiliser /api same-origin.
VITE_API_BASE_URL=http://localhost:4000
