# VPS Hostinger (KVM2) — connexion SSH
VPS_HOST=
VPS_PORT=22
VPS_USER=root
# Une seule des deux méthodes ci-dessous :
VPS_PASSWORD=
VPS_SSH_KEY_PATH=

# Cortex API — VPS/runtime
API_HOST=127.0.0.1
API_PORT=4000
CORTEX_API_TOKEN=
CORTEX_TOKEN_BUDGET=120000
CORTEX_STEP_TIMEOUT_SECONDS=1800
# Optionnel : origines autorisées si un navigateur contacte Fastify directement.
CORTEX_ALLOWED_ORIGINS=

# Vercel server-side proxy — jamais de secret préfixé VITE_
CORTEX_API_ORIGIN=
# CORTEX_API_TOKEN doit avoir exactement la même valeur côté Vercel et côté VPS.
# Session signée partagée par le runtime et le proxy Vercel. Génère une valeur longue et aléatoire.
# En production : 32 caractères minimum, exactement la même valeur sur Vercel et le VPS.
CORTEX_SESSION_SECRET=
# Compatibilité avec le compte opérateur historique. Les nouveaux comptes sont stockés côté runtime.
CORTEX_ACCESS_USER=boss
CORTEX_ACCESS_PASSWORD=

# Déploiement/runtime. À définir sur production pour activer les garde-fous stricts.
CORTEX_ENV=production

# Frontend — optionnel. Vide en prod pour utiliser le proxy same-origin /api.
VITE_API_BASE_URL=

# Providers
OPENAI_API_KEY=
OPENAI_MODEL=
