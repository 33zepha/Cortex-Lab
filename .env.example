# VPS Hostinger (KVM2) — connexion SSH
VPS_HOST=
VPS_PORT=22
VPS_USER=root
# Une seule des deux méthodes ci-dessous :
VPS_PASSWORD=
VPS_SSH_KEY_PATH=

# Cortex API runtime (VPS)
# Secret partagé entre l'API Cortex centrale et le proxy Vercel.
CORTEX_API_TOKEN=
API_PORT=4000
OPENAI_API_KEY=

# Vercel server-side proxy
# URL HTTPS publique de l'API Cortex centrale (VPS / tunnel sécurisé).
CORTEX_API_ORIGIN=

# Frontend local uniquement. En preview/production, laisser vide pour utiliser /api same-origin.
VITE_API_BASE_URL=http://localhost:4000
