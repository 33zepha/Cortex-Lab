    "openai": "^7.4.0",
    "postprocessing": "^6.39.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "swr": "^2.5.0",
    "three": "^0.185.1",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
