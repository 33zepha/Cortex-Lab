{
  "name": "cortexlab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/materialize-auth-hero.mjs && vite --host",
    "build": "node scripts/materialize-auth-hero.mjs && tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "screenshot": "tsx backend/scripts/screenshot.ts",
    "test": "vitest run",
    "vps:test": "tsx backend/scripts/vps-test-connection.ts",
    "deploy:vps": "bash scripts/deploy-cortex-vps.sh",
    "mission:smoke-test": "tsx backend/scripts/run-real-mission-smoke-test.ts",
    "mission:cancel-smoke-test": "tsx backend/scripts/cancel-mission-smoke-test.ts",
    "sse:resume-smoke-test": "tsx backend/scripts/sse-resume-smoke-test.ts",
    "mission:run": "tsx backend/scripts/run-real-mission.ts",
    "api": "tsx backend/server.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@radix-ui/react-visually-hidden": "^1.1.1",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.0",
    "cmdk": "^1.0.4",
    "fastify": "^5.11.2",
